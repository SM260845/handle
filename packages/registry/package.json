{
  "name": "@handle/registry",
  "version": "0.0.0",
  "private": true,
  "description": "Handle reservation + DNS/email maps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite-store.d.ts",
      "import": "./dist/sqlite-store.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --dir packages/registry"
  },
  "dependencies": {
    "@handle/quota": "workspace:*"
  },
  "engines": {
    "node": ">=22.5"
  }
}
