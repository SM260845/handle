{
  "name": "@handle/api",
  "version": "0.0.0",
  "private": true,
  "description": "Control plane HTTP API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --dir packages/api"
  },
  "dependencies": {
    "@handle/quota": "workspace:*",
    "@handle/registry": "workspace:*"
  }
}
